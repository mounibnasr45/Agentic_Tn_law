# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Python bytecode / build artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtualenvs
.venv
venv/
env/

# Generated indices and local state.
# NOTE: documents/ is deliberately NOT ignored — the Constitution and Penal Code
# are the corpus and are tracked until they move to object storage.
vector_store/
LOG_FILE
.coverage
coverage.xml
.pytest_cache/
.ruff_cache/

# Frontend (web/) — Node toolchain.
# `dist/` above already covers the Angular build output. package-lock.json is
# deliberately NOT ignored: CI runs `npm ci`, which requires it and fails without it.
node_modules/
# Angular CLI build cache
.angular/
*.tsbuildinfo

.DS_Store
