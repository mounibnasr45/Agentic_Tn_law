# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Auth ---
# REQUIRED in production. Minimum 32 bytes (RFC 7518 §3.2 for HMAC-SHA256); the app
# refuses to start below that. Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The committed default is an INSECURE placeholder: anyone who reads this public
# repository could otherwise forge a token for any user.
JWT_SECRET=
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- Database ---
DATABASE_URL=postgresql+psycopg://legal:legal@localhost:5432/legal

# --- API ---
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
AGENT_LLM_MODEL=deepseek/deepseek-chat

# --- Retrieval ---
# e5-small: 512 tokens. The previous encoder (MiniLM-L12) accepted only 128 and silently
# truncated 38% of chunks, dropping 12% of the corpus before it was ever embedded — see
# eval/README.md. Both are 384-dim, so swapping needs no migration.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K_RETRIEVER=20
# 0.0 = dense only (the measured best), 1.0 = lexical only, between = hybrid.
HYBRID_WEIGHT_BM25=0.0
CANDIDATE_LIMIT=50

# --- Reflection checkpoint ---
# After the agent drafts an answer, one extra LLM call asks whether it used a legal term of
# art the retrieved articles never defined (Article 201 names "préméditation"; the
# definition lives elsewhere). Named terms get retrieved and folded into the answer.
#
# COST: +1 LLM call per question, +2 and a retrieval when a gap is found.
# On a free-tier host that is the difference between a slow answer and a timed-out one.
# REFLECTION_ENABLED is a kill switch: flip it to false on the host's dashboard to shed the
# latency immediately, no redeploy. The feature always fails open — on timeout or upstream
# error the user still gets the draft answer, never a 502.
REFLECTION_ENABLED=true
REFLECTION_MAX_TERMS=2
# Bounds the WHOLE checkpoint (reflection + retrievals + rewrite), not each call.
REFLECTION_TIMEOUT=30
# Empty = reuse AGENT_LLM_MODEL. A smaller model here trades term-detection recall for
# latency and cost — measure on the eval set before assuming a 7B model reads French legal
# prose well enough to spot an undefined term of art.
REFLECTION_LLM_MODEL=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
