# Copy to .env and fill in. .env is gitignored — never commit it.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
AGENT_LLM_MODEL=deepseek/deepseek-chat
SUMMARY_LLM_MODEL=mistralai/mistral-7b-instruct-v0.2

# --- Retrieval ---
# NOTE: the current encoder (paraphrase-multilingual-MiniLM-L12-v2) has
# max_seq_length=128 tokens. CHUNK_SIZE is in CHARACTERS (~700 chars is
# ~200-250 French tokens), so chunks are silently truncated at encode time.
# Tracked as bug 13; the ablation harness quantifies the fix.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K_RETRIEVER=20
HYBRID_WEIGHT_BM25=0.4

# --- Agent ---
AGENT_MAX_ITERATIONS=10
AGENT_REQUEST_TIMEOUT=120

# --- Paths ---
DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=vector_store
